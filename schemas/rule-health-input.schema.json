{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://zipzap.local/schemas/rule-health-input.schema.json",
  "title": "ZipZap Rule Health Input",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "operation",
    "project"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "operation": {
      "enum": [
        "diagnose",
        "ignore",
        "restore",
        "list-ignored"
      ]
    },
    "project": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "locator"
      ],
      "properties": {
        "locator": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "depth": {
      "enum": [
        "quick",
        "standard",
        "deep"
      ],
      "default": "quick"
    },
    "manifest": {
      "$ref": "./project-manifest.schema.json"
    },
    "selector_catalog": {
      "type": "object",
      "additionalProperties": {
        "type": "array",
        "uniqueItems": true,
        "items": {
          "type": "string"
        }
      }
    },
    "required_topics": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string"
      }
    },
    "max_instruction_lines": {
      "type": "integer",
      "minimum": 1
    },
    "semantic_budget": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "max_source_files"
      ],
      "properties": {
        "max_source_files": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100
        }
      }
    },
    "semantic_assessment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "findings"
      ],
      "properties": {
        "findings": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/semanticFinding"
          }
        }
      }
    },
    "include_ignored": {
      "type": "boolean",
      "default": false
    },
    "finding": {
      "$ref": "./rule-health-output.schema.json#/$defs/finding"
    },
    "fingerprint": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "actor": {
      "type": "string",
      "minLength": 1
    },
    "reason": {
      "type": "string"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time"
    }
  },
  "$defs": {
    "semanticFinding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "category",
        "severity",
        "confidence",
        "source_refs",
        "evidence",
        "impact",
        "recommendation"
      ],
      "properties": {
        "category": {
          "enum": [
            "semantic-duplicate",
            "semantic-conflict",
            "unclear-precedence",
            "mixed-responsibilities",
            "project-structure-mismatch",
            "missing-applicability",
            "likely-superseded",
            "duplicated-business-rule",
            "excessive-design-sources",
            "whole-document-reference",
            "archived-design-authority"
          ]
        },
        "severity": {
          "enum": [
            "blocker",
            "high",
            "medium",
            "low",
            "advisory"
          ]
        },
        "confidence": {
          "enum": [
            "high",
            "medium",
            "low"
          ]
        },
        "source_refs": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "source_id"
            ],
            "properties": {
              "source_id": {
                "type": "string"
              },
              "heading": {
                "type": "string"
              }
            }
          }
        },
        "evidence": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "source_id"
            ],
            "properties": {
              "id": {
                "type": "string"
              },
              "source_id": {
                "type": "string"
              },
              "heading": {
                "type": "string"
              }
            }
          }
        },
        "impact": {
          "type": "string",
          "minLength": 1
        },
        "recommendation": {
          "type": "string",
          "minLength": 1
        },
        "migration_proposal": {
          "type": [
            "object",
            "null"
          ]
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "operation": {
            "const": "diagnose"
          }
        }
      },
      "then": {
        "required": [
          "manifest"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "operation": {
            "const": "ignore"
          }
        }
      },
      "then": {
        "required": [
          "finding",
          "actor"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "operation": {
            "const": "restore"
          }
        }
      },
      "then": {
        "required": [
          "fingerprint",
          "actor"
        ]
      }
    }
  ]
}
