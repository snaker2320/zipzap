{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://zipzap.local/schemas/decision-bundle.schema.json",
  "title": "ZipZap Decision Bundle",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "title",
    "context",
    "required_authority",
    "submit_mode",
    "questions",
    "preview_required"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "context": {
      "type": "string",
      "minLength": 1
    },
    "required_authority": {
      "type": "string",
      "minLength": 1
    },
    "submit_mode": {
      "enum": [
        "atomic",
        "incremental"
      ]
    },
    "state_revision": {
      "type": "integer",
      "minimum": 1
    },
    "questions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/question"
      }
    },
    "preview_required": {
      "type": "boolean"
    }
  },
  "$defs": {
    "option": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "label",
        "description",
        "recommended"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "label": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "recommended": {
          "type": "boolean"
        }
      }
    },
    "question": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "kind",
        "label",
        "description",
        "required",
        "options",
        "current_value"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "field": {
          "type": "string",
          "minLength": 1
        },
        "source_decision_code": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "kind": {
          "enum": [
            "single-select",
            "multi-select",
            "confirm"
          ]
        },
        "label": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "required": {
          "type": "boolean"
        },
        "min_selections": {
          "type": "integer",
          "minimum": 0
        },
        "max_selections": {
          "type": "integer",
          "minimum": 1
        },
        "options": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/option"
          }
        },
        "current_value": {
          "oneOf": [
            {
              "type": "string"
            },
            {
              "type": "array",
              "uniqueItems": true,
              "items": {
                "type": "string"
              }
            },
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "kind": {
                "const": "multi-select"
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "required": [
              "min_selections"
            ]
          },
          "else": {
            "not": {
              "anyOf": [
                {
                  "required": [
                    "min_selections"
                  ]
                },
                {
                  "required": [
                    "max_selections"
                  ]
                }
              ]
            }
          }
        }
      ]
    }
  }
}
