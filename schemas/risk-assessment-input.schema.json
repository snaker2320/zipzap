{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://zipzap.local/schemas/risk-assessment-input.schema.json",
  "title": "ZipZap L5 Risk Assessment Input",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "taxonomy_version",
    "invocation",
    "evidence"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "taxonomy_version": {
      "const": 1
    },
    "invocation": {
      "allOf": [
        {
          "$ref": "./l5-input.schema.json"
        },
        {
          "properties": {
            "operation": {
              "const": "execute"
            }
          },
          "required": [
            "operation",
            "request"
          ]
        }
      ]
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "kind",
          "locator",
          "statement"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          },
          "kind": {
            "enum": [
              "project-rule",
              "artifact",
              "user-statement",
              "host-observation"
            ]
          },
          "locator": {
            "type": "string",
            "minLength": 1
          },
          "statement": {
            "type": "string",
            "minLength": 1
          },
          "authority": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}
