{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://zipzap.local/schemas/conformance-result.schema.json",
  "title": "ZipZap L6 Conformance Result",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "compatible",
    "selected_adapter",
    "fallback_used",
    "interface_versions",
    "governance_preserved",
    "capability_matrix",
    "checks",
    "missing_capabilities",
    "limitations"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "compatible": {
      "type": "boolean"
    },
    "selected_adapter": {
      "oneOf": [
        {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        {
          "type": "null"
        }
      ]
    },
    "fallback_used": {
      "type": "boolean"
    },
    "interface_versions": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "l5",
        "kernel"
      ],
      "properties": {
        "l5": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1
        },
        "kernel": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1
        }
      }
    },
    "governance_preserved": {
      "type": "boolean"
    },
    "capability_matrix": {
      "$ref": "./host-capability-matrix.schema.json"
    },
    "checks": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "passed",
          "message"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          },
          "passed": {
            "type": "boolean"
          },
          "message": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "missing_capabilities": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "limitations": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  }
}
