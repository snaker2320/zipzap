{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://zipzap.local/schemas/phase-plan-assessment.schema.json",
  "title": "ZipZap Phase Plan Assessment",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "plan_id",
    "plan_revision",
    "as_of",
    "status",
    "summary",
    "items",
    "next_actions"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "plan_id": { "type": "string" },
    "plan_revision": { "type": "integer", "minimum": 1 },
    "as_of": { "type": "string", "format": "date-time" },
    "status": {
      "enum": ["on-track", "at-risk", "overdue", "blocked", "invalid"]
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["total", "completed", "on_track", "at_risk", "overdue", "blocked", "invalid"],
      "properties": {
        "total": { "type": "integer", "minimum": 0 },
        "completed": { "type": "integer", "minimum": 0 },
        "on_track": { "type": "integer", "minimum": 0 },
        "at_risk": { "type": "integer", "minimum": 0 },
        "overdue": { "type": "integer", "minimum": 0 },
        "blocked": { "type": "integer", "minimum": 0 },
        "invalid": { "type": "integer", "minimum": 0 }
      }
    },
    "items": { "type": "array", "items": { "type": "object" } },
    "next_actions": { "type": "array", "items": { "type": "string" } }
  }
}
