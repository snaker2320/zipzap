{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://zipzap.local/schemas/lifecycle-output.schema.json",
  "title": "ZipZap L7 Lifecycle Result",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "operation",
    "status",
    "allowed",
    "release_manifest",
    "checks",
    "required_actions",
    "migration_plan"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "operation": {
      "enum": [
        "build-release",
        "verify-release",
        "publish",
        "install",
        "upgrade",
        "rollback"
      ]
    },
    "status": {
      "enum": [
        "ready",
        "blocked"
      ]
    },
    "allowed": {
      "type": "boolean"
    },
    "release_manifest": {
      "oneOf": [
        {
          "$ref": "./release-manifest.schema.json"
        },
        {
          "type": "null"
        }
      ]
    },
    "checks": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "passed",
          "message"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          },
          "passed": {
            "type": "boolean"
          },
          "message": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "required_actions": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "migration_plan": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "from_version",
          "to_version",
          "description"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          },
          "from_version": {
            "$ref": "#/$defs/semver"
          },
          "to_version": {
            "$ref": "#/$defs/semver"
          },
          "description": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  },
  "$defs": {
    "semver": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-[0-9A-Za-z.-]+)?(?:\\+[0-9A-Za-z.-]+)?$"
    }
  }
}
