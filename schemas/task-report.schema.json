{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://zipzap.local/schemas/task-report.schema.json",
  "title": "ZipZap Task Report",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "period",
    "scope",
    "window",
    "summary",
    "tasks",
    "limitations"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "period": {
      "enum": [
        "daily",
        "weekly"
      ]
    },
    "scope": {
      "enum": [
        "person",
        "team"
      ]
    },
    "subject_id": {
      "type": "string"
    },
    "team_id": {
      "type": "string"
    },
    "window": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "from",
        "to"
      ],
      "properties": {
        "from": {
          "type": "string",
          "format": "date-time"
        },
        "to": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "summary": {
      "type": "object"
    },
    "tasks": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}
