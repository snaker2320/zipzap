{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://zipzap.local/schemas/task-flow-packet.schema.json",
  "title": "ZipZap Task Flow Packet",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "kind", "task", "assignee_id", "acceptance_criteria", "blockers", "findings", "sources", "evidence", "handoff", "next"],
  "properties": {
    "schema_version": { "const": 1 },
    "kind": { "const": "task-flow-packet" },
    "task": {
      "type": "object",
      "additionalProperties": false,
      "required": ["task_id", "revision", "status", "objective", "scope", "constraints"],
      "properties": {
        "task_id": { "$ref": "#/$defs/id" },
        "revision": { "type": "integer", "minimum": 1 },
        "status": { "enum": ["ready", "in-progress", "blocked", "review", "completed", "cancelled"] },
        "objective": { "$ref": "#/$defs/text" },
        "scope": { "$ref": "#/$defs/text_list" },
        "constraints": { "$ref": "#/$defs/text_list" }
      }
    },
    "assignee_id": { "type": ["string", "null"], "minLength": 1 },
    "acceptance_criteria": { "type": "array", "items": { "$ref": "#/$defs/acceptance_criterion" } },
    "blockers": { "type": "array", "items": { "$ref": "#/$defs/blocker" } },
    "findings": { "type": "array", "items": { "$ref": "#/$defs/finding" } },
    "sources": { "type": "array", "items": { "$ref": "#/$defs/source" } },
    "evidence": { "type": "array", "items": { "$ref": "#/$defs/evidence" } },
    "handoff": {
      "oneOf": [
        { "$ref": "#/$defs/handoff" },
        { "type": "null" }
      ]
    },
    "next": { "$ref": "#/$defs/next" }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
    "text": { "type": "string", "minLength": 1 },
    "text_list": { "type": "array", "items": { "$ref": "#/$defs/text" } },
    "id_list": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/id" } },
    "acceptance_criterion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "statement", "status"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "statement": { "$ref": "#/$defs/text" },
        "status": { "enum": ["pass", "fail", "unknown"] }
      }
    },
    "blocker": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "statement", "resolution_condition"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "statement": { "$ref": "#/$defs/text" },
        "resolution_condition": { "$ref": "#/$defs/text" }
      }
    },
    "finding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "statement", "status", "severity", "blocking"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "statement": { "$ref": "#/$defs/text" },
        "status": { "enum": ["open", "deferred"] },
        "severity": { "type": ["string", "null"] },
        "blocking": { "type": "boolean" }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "locator"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "kind": { "enum": ["project-rule", "requirement", "design", "issue", "decision", "other"] },
        "locator": { "$ref": "#/$defs/text" }
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "locator", "statement", "status", "criteria_refs"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "kind": { "enum": ["project-rule", "artifact", "user-statement", "host-observation", "verification", "review", "git"] },
        "locator": { "$ref": "#/$defs/text" },
        "statement": { "$ref": "#/$defs/text" },
        "status": { "enum": ["pass", "fail", "unknown", null] },
        "criteria_refs": { "$ref": "#/$defs/id_list" }
      }
    },
    "artifact_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": ["locator"],
      "properties": {
        "locator": { "$ref": "#/$defs/text" },
        "version": { "type": ["string", "null"] }
      }
    },
    "handoff": {
      "type": "object",
      "additionalProperties": false,
      "required": ["handoff_id", "task_revision", "fresh", "summary", "artifact_refs", "decision_refs", "evidence_refs", "finding_refs", "blocker_refs"],
      "properties": {
        "handoff_id": { "$ref": "#/$defs/id" },
        "task_revision": { "type": "integer", "minimum": 1 },
        "fresh": { "type": "boolean" },
        "summary": { "$ref": "#/$defs/text" },
        "artifact_refs": { "type": "array", "items": { "$ref": "#/$defs/artifact_ref" } },
        "decision_refs": { "$ref": "#/$defs/id_list" },
        "evidence_refs": { "$ref": "#/$defs/id_list" },
        "finding_refs": { "$ref": "#/$defs/id_list" },
        "blocker_refs": { "$ref": "#/$defs/id_list" }
      }
    },
    "next": {
      "type": "object",
      "additionalProperties": false,
      "required": ["role", "stage", "action"],
      "properties": {
        "role": { "type": ["string", "null"] },
        "stage": { "type": ["string", "null"] },
        "action": { "$ref": "#/$defs/text" }
      }
    }
  }
}
