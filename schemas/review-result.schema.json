{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://zipzap.local/schemas/review-result.schema.json",
  "title": "ZipZap Review Result",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "review_id",
    "task_id",
    "reviewer",
    "created_at",
    "outcome",
    "coverage",
    "findings",
    "evidence_refs"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "review_id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "task_id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "reviewer": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "subject_id",
        "independence"
      ],
      "properties": {
        "subject_id": {
          "type": "string",
          "minLength": 1
        },
        "context_id": {
          "type": "string"
        },
        "independence": {
          "enum": [
            "self",
            "peer",
            "independent"
          ]
        }
      }
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "outcome": {
      "enum": [
        "approved",
        "changes-requested",
        "blocked",
        "advisory"
      ]
    },
    "coverage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "scope",
        "limitations"
      ],
      "properties": {
        "scope": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "limitations": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "statement",
          "severity",
          "blocking",
          "status",
          "evidence_refs"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "statement": {
            "type": "string",
            "minLength": 1
          },
          "severity": {
            "enum": [
              "blocker",
              "high",
              "medium",
              "low",
              "advisory"
            ]
          },
          "blocking": {
            "type": "boolean"
          },
          "status": {
            "enum": [
              "open",
              "fixed",
              "accepted",
              "deferred",
              "duplicate",
              "not-reproducible"
            ]
          },
          "evidence_refs": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "evidence_refs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}
