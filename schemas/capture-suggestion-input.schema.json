{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://zipzap.local/schemas/capture-suggestion-input.schema.json",
  "title": "ZipZap Capture Suggestion Input",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "operation"],
  "properties": {
    "schema_version": { "const": 1 },
    "operation": { "enum": ["start", "confirm"] },
    "locale": { "enum": ["en", "zh-CN"], "default": "zh-CN" },
    "presentation": { "enum": ["form", "stepwise"], "default": "form" },
    "suggestion": { "$ref": "#/$defs/suggestion" },
    "state": { "$ref": "#/$defs/state" },
    "expected_revision": { "type": "integer", "minimum": 1 },
    "decision": { "$ref": "#/$defs/decision" }
  },
  "allOf": [
    {
      "if": {
        "properties": { "operation": { "const": "start" } },
        "required": ["operation"]
      },
      "then": { "required": ["suggestion"] }
    },
    {
      "if": {
        "properties": { "operation": { "const": "confirm" } },
        "required": ["operation"]
      },
      "then": { "required": ["state", "expected_revision", "decision"] }
    }
  ],
  "$defs": {
    "suggestion": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "suggestion_id",
        "type",
        "summary",
        "severity",
        "current_work_impact",
        "evidence"
      ],
      "properties": {
        "suggestion_id": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "type": { "enum": ["requirement", "defect", "technical-debt"] },
        "summary": { "type": "string", "minLength": 1 },
        "expected_outcome": { "type": "string", "minLength": 1 },
        "severity": {
          "enum": ["blocker", "high", "medium", "low", "advisory"]
        },
        "current_work_impact": { "enum": ["blocking", "related", "unrelated"] },
        "current_task_id": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "active_plan_id": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "task_candidate": { "$ref": "./task.schema.json" },
        "evidence": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/evidence" }
        }
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "locator", "statement"],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "kind": {
          "enum": ["analysis", "artifact", "implementation", "test", "review", "decision", "other"]
        },
        "locator": { "type": "string", "minLength": 1 },
        "statement": { "type": "string", "minLength": 1 }
      }
    },
    "state": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "revision",
        "locale",
        "presentation",
        "suggestion",
        "recommended_action",
        "prompt_timing"
      ],
      "properties": {
        "revision": { "type": "integer", "minimum": 1 },
        "locale": { "enum": ["en", "zh-CN"] },
        "presentation": { "enum": ["form", "stepwise"] },
        "suggestion": { "$ref": "#/$defs/suggestion" },
        "recommended_action": {
          "enum": ["create-demand", "attach-current-task", "create-task"]
        },
        "prompt_timing": {
          "enum": ["immediate", "stage-end", "completion-summary"]
        },
        "current_task_revision": { "type": "integer", "minimum": 1 },
        "active_plan_revision": { "type": "integer", "minimum": 1 }
      }
    },
    "decision": {
      "type": "object",
      "additionalProperties": false,
      "required": ["action"],
      "properties": {
        "action": {
          "enum": ["create-demand", "attach-current-task", "create-task", "dismiss"]
        },
        "demand_id": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "priority": { "enum": ["critical", "high", "medium", "low"] },
        "owner_id": { "type": ["string", "null"], "minLength": 1 },
        "timing": { "$ref": "./demand.schema.json#/$defs/timing" },
        "current_task_expected_revision": { "type": "integer", "minimum": 1 },
        "task": { "$ref": "./task.schema.json" },
        "add_to_plan": { "type": "boolean", "default": false },
        "plan_expected_revision": { "type": "integer", "minimum": 1 }
      }
    }
  }
}
