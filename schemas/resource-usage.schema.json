{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://zipzap.local/schemas/resource-usage.schema.json",
  "title": "ZipZap Resource Usage Record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "usage_id",
    "task_id",
    "task_revision",
    "recorded_at",
    "resource_usage"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "usage_id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "task_id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "task_revision": {
      "type": "integer",
      "minimum": 1
    },
    "recorded_at": {
      "type": "string",
      "format": "date-time"
    },
    "actor_id": {
      "type": "string",
      "minLength": 1
    },
    "resource_usage": {
      "$ref": "#/$defs/resource_usage"
    },
    "goal": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "authorization",
        "token_budget"
      ],
      "properties": {
        "authorization": {
          "const": "explicit-user"
        },
        "token_budget": {
          "type": "integer",
          "minimum": 1
        },
        "goal_id": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  },
  "$defs": {
    "resource_usage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "measurement",
        "source"
      ],
      "properties": {
        "measurement": {
          "enum": [
            "exact",
            "unavailable"
          ]
        },
        "source": {
          "type": "string",
          "minLength": 1
        },
        "input_tokens": {
          "type": "integer",
          "minimum": 0
        },
        "output_tokens": {
          "type": "integer",
          "minimum": 0
        },
        "tool_result_tokens": {
          "type": "integer",
          "minimum": 0
        },
        "total_tokens": {
          "type": "integer",
          "minimum": 0
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "measurement": {
                "const": "exact"
              }
            },
            "required": [
              "measurement"
            ]
          },
          "then": {
            "required": [
              "input_tokens",
              "output_tokens",
              "tool_result_tokens",
              "total_tokens"
            ]
          },
          "else": {
            "not": {
              "anyOf": [
                {
                  "required": [
                    "input_tokens"
                  ]
                },
                {
                  "required": [
                    "output_tokens"
                  ]
                },
                {
                  "required": [
                    "tool_result_tokens"
                  ]
                },
                {
                  "required": [
                    "total_tokens"
                  ]
                }
              ]
            }
          }
        }
      ]
    }
  }
}
