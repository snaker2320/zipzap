{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://zipzap.local/schemas/rule-health-output.schema.json",
  "title": "ZipZap Rule Health Output",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "status"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "status": {
      "enum": [
        "completed",
        "ignored",
        "restored"
      ]
    },
    "depth": {
      "enum": [
        "quick",
        "standard",
        "deep"
      ]
    },
    "findings": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/finding"
      }
    },
    "ignored_count": {
      "type": "integer",
      "minimum": 0
    },
    "semantic_review_request": {
      "type": [
        "object",
        "null"
      ]
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "ignored": {
      "type": "array",
      "items": {
        "$ref": "./rule-health-ignore.schema.json"
      }
    },
    "locator": {
      "type": "string"
    },
    "record": {
      "$ref": "./rule-health-ignore.schema.json"
    },
    "fingerprint": {
      "type": "string"
    }
  },
  "$defs": {
    "finding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "fingerprint",
        "category",
        "severity",
        "confidence",
        "source_refs",
        "evidence",
        "impact",
        "recommendation",
        "migration_proposal",
        "disposition"
      ],
      "properties": {
        "fingerprint": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        },
        "category": {
          "type": "string",
          "minLength": 1
        },
        "severity": {
          "enum": [
            "blocker",
            "high",
            "medium",
            "low",
            "advisory"
          ]
        },
        "confidence": {
          "enum": [
            "high",
            "medium",
            "low"
          ]
        },
        "source_refs": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "evidence": {
          "type": "array"
        },
        "impact": {
          "type": "string"
        },
        "recommendation": {
          "type": "string"
        },
        "migration_proposal": {
          "type": [
            "object",
            "null"
          ]
        },
        "disposition": {
          "enum": [
            "open",
            "ignored"
          ]
        }
      }
    }
  }
}
