{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://zipzap.local/schemas/task-progress.schema.json",
  "title": "ZipZap Task Progress Event",
  "description": "One host-consumable JSON Lines snapshot emitted by task watch.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "event",
    "sequence",
    "change",
    "observed_at",
    "task_id",
    "revision",
    "status",
    "stage",
    "terminal",
    "assignee_id",
    "objective",
    "blockers",
    "updated_at"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "event": {
      "const": "task-progress"
    },
    "sequence": {
      "type": "integer",
      "minimum": 1
    },
    "change": {
      "enum": [
        "initial",
        "revision",
        "heartbeat",
        "terminal"
      ]
    },
    "observed_at": {
      "type": "string",
      "format": "date-time"
    },
    "task_id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "revision": {
      "type": "integer",
      "minimum": 1
    },
    "status": {
      "enum": [
        "ready",
        "in-progress",
        "blocked",
        "review",
        "completed",
        "cancelled"
      ]
    },
    "stage": {
      "enum": [
        "queued",
        "implementation",
        "blocked",
        "review",
        "completed",
        "cancelled"
      ]
    },
    "terminal": {
      "type": "boolean"
    },
    "assignee_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "objective": {
      "type": "string",
      "minLength": 1
    },
    "blockers": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "statement",
          "resolution_condition"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "statement": {
            "type": "string"
          },
          "resolution_condition": {
            "type": "string"
          }
        }
      }
    },
    "updated_at": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    }
  }
}
