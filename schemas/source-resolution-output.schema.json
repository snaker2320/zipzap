{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://zipzap.local/schemas/source-resolution-output.schema.json",
  "title": "ZipZap Source Resolution Output",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "status",
    "matches",
    "coverage",
    "limitations"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "status": {
      "enum": [
        "ready",
        "decision-required",
        "blocked"
      ]
    },
    "matches": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/match"
      }
    },
    "coverage": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/coverage"
      }
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "$defs": {
    "match": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_id",
        "locator",
        "matched_topics",
        "availability",
        "load_required"
      ],
      "properties": {
        "source_id": {
          "type": "string",
          "minLength": 1
        },
        "locator": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "type": "string"
        },
        "format": {
          "type": "string"
        },
        "loading": {
          "type": "string"
        },
        "matched_topics": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "availability": {
          "enum": [
            "available",
            "unavailable",
            "stale"
          ]
        },
        "load_required": {
          "type": "boolean"
        },
        "version": {
          "type": [
            "string",
            "null"
          ]
        },
        "priority": {
          "type": "integer"
        }
      }
    },
    "coverage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "topic",
        "status",
        "source_ids"
      ],
      "properties": {
        "topic": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "enum": [
            "covered",
            "host-preloaded",
            "missing",
            "unavailable",
            "stale"
          ]
        },
        "source_ids": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    }
  }
}
