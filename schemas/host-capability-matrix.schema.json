{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://zipzap.local/schemas/host-capability-matrix.schema.json",
  "title": "ZipZap Host Capability Matrix",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "assessed",
    "entries",
    "limitations"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "assessed": {
      "type": "boolean"
    },
    "entries": {
      "type": "array",
      "minItems": 6,
      "maxItems": 6,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "label",
          "status",
          "summary",
          "fallback"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          },
          "label": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "enum": [
              "available",
              "authorization-required",
              "degraded",
              "unavailable",
              "unknown"
            ]
          },
          "summary": {
            "type": "string",
            "minLength": 1
          },
          "fallback": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      }
    },
    "limitations": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  }
}
