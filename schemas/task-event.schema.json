{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://zipzap.local/schemas/task-event.schema.json",
  "title": "ZipZap Task Event",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "event_id",
    "task_id",
    "type",
    "occurred_at",
    "data"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "event_id": {
      "type": "string",
      "minLength": 1
    },
    "task_id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "type": {
      "enum": [
        "created",
        "updated",
        "transitioned",
        "git-tracking-configured",
        "git-synced",
        "review-recorded",
        "review-updated",
        "completion-assessed",
        "usage-recorded"
      ]
    },
    "occurred_at": {
      "type": "string",
      "format": "date-time"
    },
    "actor_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "base_revision": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 1
    },
    "next_revision": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 1
    },
    "data": {
      "type": "object"
    }
  }
}
