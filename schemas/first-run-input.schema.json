{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://zipzap.local/schemas/first-run-input.schema.json",
  "title": "ZipZap First Run Input",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "operation"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "operation": {
      "enum": [
        "start",
        "answer",
        "submit",
        "confirm"
      ]
    },
    "presentation": {
      "enum": [
        "form",
        "stepwise"
      ],
      "default": "form"
    },
    "project": {
      "$ref": "#/$defs/project"
    },
    "enabled_roles": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": [
          "product",
          "developer",
          "tester",
          "reviewer"
        ]
      }
    },
    "state": {
      "$ref": "#/$defs/state"
    },
    "expected_revision": {
      "type": "integer",
      "minimum": 1
    },
    "answer": {
      "$ref": "./onboarding-input.schema.json#/properties/answer"
    },
    "answers": {
      "$ref": "./onboarding-input.schema.json#/$defs/answers"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "operation": {
            "const": "start"
          }
        },
        "required": [
          "operation"
        ]
      },
      "then": {
        "required": [
          "project"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "operation": {
            "enum": [
              "answer",
              "submit",
              "confirm"
            ]
          }
        },
        "required": [
          "operation"
        ]
      },
      "then": {
        "required": [
          "state",
          "expected_revision"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "operation": {
            "const": "answer"
          }
        },
        "required": [
          "operation"
        ]
      },
      "then": {
        "required": [
          "answer"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "operation": {
            "const": "submit"
          }
        },
        "required": [
          "operation"
        ]
      },
      "then": {
        "required": [
          "answers"
        ]
      }
    }
  ],
  "$defs": {
    "project": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "locator"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "locator": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "state": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "revision",
        "stage",
        "project",
        "enabled_roles",
        "discovery_fingerprint",
        "onboarding_state"
      ],
      "properties": {
        "revision": {
          "type": "integer",
          "minimum": 1
        },
        "stage": {
          "enum": [
            "collecting",
            "preview-ready"
          ]
        },
        "project": {
          "$ref": "#/$defs/project"
        },
        "enabled_roles": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "product",
              "developer",
              "tester",
              "reviewer"
            ]
          }
        },
        "discovery_fingerprint": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        },
        "onboarding_state": {
          "$ref": "./onboarding-input.schema.json#/$defs/state"
        }
      }
    }
  }
}
