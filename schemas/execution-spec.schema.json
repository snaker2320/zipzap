{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://zipzap.local/schemas/execution-spec.schema.json",
  "title": "ZipZap ExecutionSpec",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "objective",
    "scope",
    "requested_action",
    "affected_components",
    "affected_files",
    "participant",
    "module_ids",
    "capability_profile_ids",
    "capability_profiles",
    "facts",
    "source_refs",
    "governance",
    "budget",
    "revisions",
    "limitations",
    "unresolved",
    "spec_digest"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "objective": { "type": "string" },
    "scope": { "type": "array", "items": { "type": "string" } },
    "requested_action": { "type": "string" },
    "affected_components": { "type": "array", "items": { "type": "string" } },
    "affected_files": { "type": "array", "items": { "type": "string" } },
    "participant": { "type": "object" },
    "module_ids": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
    "capability_profile_ids": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
    "capability_profiles": { "type": "array", "items": { "type": "object" } },
    "facts": { "type": "array", "items": { "$ref": "./capability-profile.schema.json#/$defs/fact" } },
    "source_refs": { "type": "array", "items": { "type": "object" } },
    "governance": { "type": "object" },
    "budget": { "type": ["object", "null"] },
    "revisions": { "type": "object" },
    "limitations": { "type": "array", "items": { "type": "string" } },
    "unresolved": { "type": "array", "items": { "type": "string" } },
    "spec_digest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" }
  }
}
