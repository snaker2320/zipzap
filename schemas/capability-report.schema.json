{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://zipzap.local/schemas/capability-report.schema.json",
  "title": "ZipZap AI Collaboration Capability Report",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "window",
    "profiles",
    "comparison_limitations"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "window": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "from",
        "to"
      ],
      "properties": {
        "from": {
          "type": "string",
          "format": "date-time"
        },
        "to": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "profiles": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/profile"
      }
    },
    "comparison_limitations": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "$defs": {
    "profile": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "subject_id",
        "sample",
        "task_mix",
        "dimensions",
        "limitations"
      ],
      "properties": {
        "subject_id": {
          "type": "string",
          "minLength": 1
        },
        "sample": {
          "type": "object"
        },
        "task_mix": {
          "type": "object"
        },
        "dimensions": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/dimension"
          }
        },
        "limitations": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "dimension": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "assessment",
        "confidence",
        "evidence_refs"
      ],
      "properties": {
        "assessment": {
          "enum": [
            "strong",
            "steady",
            "developing",
            "insufficient-evidence"
          ]
        },
        "confidence": {
          "enum": [
            "low",
            "medium",
            "high"
          ]
        },
        "evidence_refs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    }
  }
}
