{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://zipzap.local/schemas/diagnostic-review.schema.json",
  "title": "ZipZap Design Diagnostic Review",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "review_kind",
    "subject_ref",
    "reviewer",
    "created_at",
    "judgment",
    "claim",
    "positive_conclusions",
    "findings",
    "coverage",
    "boundaries",
    "owner_decisions",
    "upgrade",
    "execution_report",
    "evidence_refs"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "review_kind": {
      "const": "design-diagnostic"
    },
    "subject_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "locator"
      ],
      "properties": {
        "locator": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": [
            "string",
            "null"
          ]
        },
        "task_id": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "reviewer": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "subject_id",
        "independence"
      ],
      "properties": {
        "subject_id": {
          "type": "string",
          "minLength": 1
        },
        "context_id": {
          "type": "string"
        },
        "independence": {
          "enum": [
            "self",
            "peer"
          ]
        }
      }
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "judgment": {
      "enum": [
        "reasonable",
        "conditionally-reasonable",
        "unreasonable"
      ]
    },
    "claim": {
      "enum": [
        "advisory",
        "self-reviewed"
      ]
    },
    "positive_conclusions": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "statement",
          "severity",
          "evidence_refs",
          "suggested_verification"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          },
          "statement": {
            "type": "string",
            "minLength": 1
          },
          "severity": {
            "enum": [
              "blocker",
              "high",
              "medium",
              "low",
              "advisory"
            ]
          },
          "evidence_refs": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "suggested_verification": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      }
    },
    "coverage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "inspected",
        "not_inspected",
        "limitations"
      ],
      "properties": {
        "inspected": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "not_inspected": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "limitations": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "boundaries": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "local_feasibility",
        "production_acceptability"
      ],
      "properties": {
        "local_feasibility": {
          "type": "string",
          "minLength": 1
        },
        "production_acceptability": {
          "const": "not-assessed"
        }
      }
    },
    "owner_decisions": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "upgrade": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "recommended",
        "triggers",
        "next_action"
      ],
      "properties": {
        "recommended": {
          "type": "boolean"
        },
        "triggers": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "next_action": {
          "type": [
            "string",
            "null"
          ],
          "enum": [
            "targeted-implementation-verification",
            "independent-review",
            "formal-acceptance",
            null
          ]
        }
      }
    },
    "execution_report": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_files_read",
        "tests_run",
        "mutations_performed",
        "persistence_performed",
        "agent_contexts",
        "tool_calls",
        "token_measurement"
      ],
      "properties": {
        "source_files_read": {
          "type": "integer",
          "minimum": 0
        },
        "tests_run": {
          "const": 0
        },
        "mutations_performed": {
          "const": false
        },
        "persistence_performed": {
          "const": false
        },
        "agent_contexts": {
          "const": 1
        },
        "tool_calls": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "token_measurement": {
          "enum": [
            "exact",
            "unavailable"
          ]
        },
        "input_tokens": {
          "type": "integer",
          "minimum": 0
        },
        "output_tokens": {
          "type": "integer",
          "minimum": 0
        },
        "tool_tokens": {
          "type": "integer",
          "minimum": 0
        },
        "total_tokens": {
          "type": "integer",
          "minimum": 0
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "token_measurement": {
                "const": "exact"
              }
            }
          },
          "then": {
            "required": [
              "input_tokens",
              "output_tokens",
              "tool_tokens",
              "total_tokens"
            ]
          },
          "else": {
            "not": {
              "anyOf": [
                {
                  "required": [
                    "input_tokens"
                  ]
                },
                {
                  "required": [
                    "output_tokens"
                  ]
                },
                {
                  "required": [
                    "tool_tokens"
                  ]
                },
                {
                  "required": [
                    "total_tokens"
                  ]
                }
              ]
            }
          }
        }
      ]
    },
    "evidence_refs": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  }
}
