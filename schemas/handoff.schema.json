{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://zipzap.local/schemas/handoff.schema.json",
  "title": "ZipZap Task Handoff",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "handoff_id",
    "task_id",
    "task_revision",
    "created_at",
    "summary",
    "artifact_refs",
    "decision_refs",
    "evidence_refs",
    "finding_refs",
    "blocker_refs",
    "next"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "handoff_id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "task_id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "task_revision": {
      "type": "integer",
      "minimum": 1
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "actor_id": {
      "type": "string",
      "minLength": 1
    },
    "role": {
      "enum": [
        "product",
        "developer",
        "tester",
        "reviewer"
      ]
    },
    "stage": {
      "type": "string",
      "minLength": 1
    },
    "summary": {
      "type": "string",
      "minLength": 1
    },
    "artifact_refs": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/artifact_ref"
      }
    },
    "decision_refs": {
      "$ref": "#/$defs/id_refs"
    },
    "evidence_refs": {
      "$ref": "#/$defs/id_refs"
    },
    "finding_refs": {
      "$ref": "#/$defs/id_refs"
    },
    "blocker_refs": {
      "$ref": "#/$defs/id_refs"
    },
    "next": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "role",
        "stage",
        "action"
      ],
      "properties": {
        "role": {
          "enum": [
            "product",
            "developer",
            "tester",
            "reviewer"
          ]
        },
        "stage": {
          "type": "string",
          "minLength": 1
        },
        "action": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  },
  "$defs": {
    "id_refs": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
      }
    },
    "artifact_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "locator"
      ],
      "properties": {
        "locator": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    }
  }
}
