{
  "schema_version": 1,
  "interfaces": {
    "l5": {
      "current": 2
    },
    "kernel": {
      "current": 2
    }
  },
  "adapter_order": [
    "codex-native",
    "script-accelerator",
    "direct-json"
  ],
  "adapters": {
    "codex-native": {
      "required_capabilities": [
        "native-skill-execution",
        "json-read"
      ],
      "required_runtimes": []
    },
    "script-accelerator": {
      "required_capabilities": [
        "script-execution",
        "json-read"
      ],
      "required_runtimes": [
        "node"
      ]
    },
    "direct-json": {
      "required_capabilities": [
        "json-read"
      ],
      "required_runtimes": []
    }
  },
  "operations": {
    "initialize": {
      "required_interfaces": [
        "l5"
      ],
      "required_capabilities": [
        "project-read",
        "json-read"
      ],
      "actions": {
        "discover": [],
        "configure": [
          "project-write"
        ],
        "refresh": [
          "project-write"
        ]
      }
    },
    "execute": {
      "required_interfaces": [
        "l5",
        "kernel"
      ],
      "required_capabilities": [
        "json-read"
      ]
    },
    "resume": {
      "required_interfaces": [
        "l5",
        "kernel"
      ],
      "required_capabilities": [
        "json-read"
      ],
      "any_capability_groups": [
        [
          "session-state",
          "project-state"
        ]
      ]
    },
    "inspect": {
      "required_interfaces": [
        "l5"
      ],
      "required_capabilities": [
        "json-read"
      ]
    }
  },
  "policies": {
    "no_governance_downgrade": true,
    "no_false_independence_claims": true,
    "same_public_contracts_across_adapters": true,
    "script_runtime_optional": true
  }
}
