{
  "schema_version": 1,
  "public_phases": {
    "initialize": {
      "label": "Initialize",
      "summary": "Set up project collaboration once."
    },
    "work": {
      "label": "Work",
      "summary": "Start or continue the requested work."
    },
    "complete": {
      "label": "Complete",
      "summary": "Verify evidence and finish with an accurate claim."
    }
  },
  "operation_phase": {
    "initialize": "initialize",
    "execute": "work",
    "resume": "work",
    "inspect": "complete"
  },
  "status_interaction": {
    "ready": "silent",
    "completed": "inform",
    "decision-required": "confirm",
    "preview-ready": "confirm",
    "blocked": "block"
  },
  "defaults": {
    "work_persistence": "ephemeral",
    "team_preference": "auto",
    "routine_status": "silent",
    "small_reversible_team": "solo"
  },
  "decision_interaction": {
    "initialization_confirmation": "always",
    "multi_agent_launch_confirmation": "when-authorization-unknown",
    "native_form_capability": "guided-form",
    "fallback_presentation": "stepwise",
    "pause_on_nonempty_bundle": true
  },
  "interrupt_only_for": [
    "material-ambiguity",
    "required-authorization",
    "required-approval",
    "unsafe-or-irreversible-action",
    "missing-authoritative-source",
    "unmet-required-gate"
  ],
  "policies": {
    "internal_layers_hidden_by_default": true,
    "no_task_for_routine_ephemeral_work": true,
    "no_preference_prompt_when_defaults_apply": true,
    "no_status_prompt_for_ready_work": true,
    "one_prompt_for_one_accountable_decision": true,
    "structured_choices_available_without_plan_mode": true,
    "decision_bundles_stop_execution": true,
    "non_plan_decisions_use_conversation_fallback": true,
    "uninitialized_projects_enter_first_run": true,
    "multi_agent_launch_requires_authorization": true,
    "multiple_questions_share_one_authority": true,
    "different_authorities_use_separate_bundles": true,
    "decision_preview_precedes_material_effect": true
  }
}
